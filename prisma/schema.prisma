generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AccountType {
  ATTENDEE
  ORGANIZER
}

enum OrganizerOnboardingStatus {
  NOT_STARTED
  PROFILE_INCOMPLETE
  PROFILE_COMPLETED
  PAYMENT_SETUP_PENDING
  READY_FOR_PAID_EVENTS
}

enum OrganizerProviderSelectionSource {
  AUTO_RECOMMENDED
  MANUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  PAID
  ISSUED
  TRANSFER_PENDING
  RESALE_LISTED
  USED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum ResaleStatus {
  DRAFT
  LISTED
  SOLD
  CANCELLED
  EXPIRED
}

enum ScanOutcome {
  VALID
  ALREADY_USED
  INVALID
  BLOCKED
}

enum ScanMode {
  ONLINE
  OFFLINE_SYNC
}

enum StaffRole {
  OWNER
  ADMIN
  SCANNER
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  MANUAL
}

enum PaymentAccountStatus {
  NOT_STARTED
  PENDING
  ACTION_REQUIRED
  VERIFIED
  RESTRICTED
  DISABLED
}

enum ConnectedAccountType {
  EXPRESS
  STANDARD
  CUSTOM
}

enum PaymentAccountOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ACTION_REQUIRED
  EXPIRED
}

enum PaymentVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  RESTRICTED
  DISABLED
}

enum PaymentTransactionType {
  PRIMARY_TICKET_PURCHASE
  RESALE_PURCHASE
  REFUND
  ADJUSTMENT
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_ACTION
}

enum SettlementState {
  NOT_APPLICABLE
  PENDING
  IN_TRANSIT
  SETTLED
  FAILED
  ON_HOLD
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FixedFeeApplication {
  PER_ORDER
  PER_TICKET
}

enum TicketPricingMode {
  FIXED
  FREE
  OFFER_RANGE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum NotificationType {
  ORDER_PAID
  ORGANIZER_PAYOUT_READY
  TRANSFER_CREATED
  TRANSFER_RECEIVED
  STAFF_INVITE_RECEIVED
  TRANSFER_REMINDER
  TRANSFER_ACCEPTED
  TRANSFER_CANCELLED
  TRANSFER_EXPIRED
  RESALE_LISTED
  RESALE_SOLD
  RESALE_CANCELLED
  EVENT_REMINDER
  POST_EVENT_PUBLISHED
  OFFER_REQUEST_RECEIVED
  OFFER_REQUEST_ACCEPTED
  OFFER_REQUEST_REJECTED
  OFFER_REQUEST_EXPIRED
}

enum EventShareAction {
  EVENT_SHARE_CLICKED
  EVENT_LINK_COPIED
  EVENT_FLYER_GENERATED
  EVENT_FLYER_DOWNLOADED
  PUBLIC_EVENT_PAGE_VIEWED
  GET_TICKET_FROM_PUBLIC_PAGE_CLICKED
}

enum TicketOfferRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum PushPlatform {
  IOS
  ANDROID
}

enum PushDeviceStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum OwnershipChangeType {
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  RESALE_LISTED
  RESALE_PURCHASE
  ORGANIZER_REASSIGNMENT
  REFUND
  CANCELLATION
}

model User {
  id                           String                   @id @default(cuid())
  email                        String                   @unique
  passwordHash                 String?                  @map("password_hash")
  accountType                  AccountType              @default(ATTENDEE) @map("account_type")
  status                       UserStatus               @default(ACTIVE)
  emailVerifiedAt              DateTime?                @map("email_verified_at")
  lastLoginAt                  DateTime?                @map("last_login_at")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  profile                      UserProfile?
  organizedEvents              Event[]                  @relation("event_organizer")
  orders                       Order[]
  ownedTickets                 Ticket[]                 @relation("ticket_current_owner")
  transferRequestsCreated      TransferRequest[]        @relation("transfer_sender")
  transferRequestsReceived     TransferRequest[]        @relation("transfer_recipient")
  resaleListings               ResaleListing[]          @relation("resale_seller")
  purchasedResales             ResaleListing[]          @relation("resale_buyer")
  ownershipHistoryFrom         TicketOwnershipHistory[] @relation("ownership_from_user")
  ownershipHistoryTo           TicketOwnershipHistory[] @relation("ownership_to_user")
  staffMemberships             StaffMembership[]
  scanSessionsStarted          ScanSession[]            @relation("scan_session_started_by")
  scanAttempts                 ScanAttempt[]            @relation("scan_attempt_staff")
  notifications                UserNotification[]
  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  pushDevices                  PushDevice[]
  ticketOfferRequests          TicketOfferRequest[]     @relation("offer_attendee")
  reviewedTicketOffers         TicketOfferRequest[]     @relation("offer_reviewer")
  eventShareAnalytics          EventShareAnalytics[]
  organizerProfile            OrganizerProfile?
  organizerPaymentProfile      OrganizerPaymentProfile?
  paymentAccounts              PaymentAccount[]
  organizerEarnings            OrganizerEarning[]
  organizerPaymentTransactions PaymentTransaction[]     @relation("payment_transaction_organizer")

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  phoneNumber String?  @map("phone_number")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OrganizerProfile {
  id                      String                           @id @default(cuid())
  userId                  String                           @unique @map("user_id")
  displayName             String?                          @map("display_name")
  businessName            String?                          @map("business_name")
  country                 String?
  defaultPayoutCurrency   String?                          @map("default_payout_currency")
  onboardingStatus        OrganizerOnboardingStatus        @default(NOT_STARTED) @map("onboarding_status")
  selectedPaymentProvider PaymentProvider?                 @map("selected_payment_provider")
  recommendedProvider     PaymentProvider?                 @map("recommended_provider")
  providerSelectionSource OrganizerProviderSelectionSource? @map("provider_selection_source")
  providerSelectedAt      DateTime?                        @map("provider_selected_at")
  createdAt               DateTime                         @default(now()) @map("created_at")
  updatedAt               DateTime                         @updatedAt @map("updated_at")
  user                    User                             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country, defaultPayoutCurrency])
  @@index([onboardingStatus, updatedAt])
  @@map("organizer_profiles")
}

model Event {
  id                     String                @id @default(cuid())
  organizerId            String                @map("organizer_id")
  title                  String
  slug                   String                @unique
  description            String?
  venueName              String?               @map("venue_name")
  venueAddress           String?               @map("venue_address")
  currency               String                @default("EUR")
  timezone               String
  startsAt               DateTime              @map("starts_at")
  endsAt                 DateTime?             @map("ends_at")
  status                 EventStatus           @default(DRAFT)
  coverImageUrl          String?               @map("cover_image_url")
  shareHeadline          String?               @map("share_headline")
  shareDescription       String?               @map("share_description")
  shareImageUrl          String?               @map("share_image_url")
  salesStartAt           DateTime?             @map("sales_start_at")
  salesEndAt             DateTime?             @map("sales_end_at")
  allowResale            Boolean               @default(false) @map("allow_resale")
  minResalePrice         Decimal?              @map("min_resale_price") @db.Decimal(10, 2)
  maxResalePrice         Decimal?              @map("max_resale_price") @db.Decimal(10, 2)
  resaleRoyaltyPercent   Decimal?              @map("resale_royalty_percent") @db.Decimal(5, 2)
  resaleStartsAt         DateTime?             @map("resale_starts_at")
  resaleEndsAt           DateTime?             @map("resale_ends_at")
  postEventMessage       String?               @map("post_event_message")
  postEventCtaLabel      String?               @map("post_event_cta_label")
  postEventCtaUrl        String?               @map("post_event_cta_url")
  postEventPublishedAt   DateTime?             @map("post_event_published_at")
  postEventNotifiedAt    DateTime?             @map("post_event_notified_at")
  preEventReminderSentAt DateTime?             @map("pre_event_reminder_sent_at")
  offlineManifestSalt    String?               @map("offline_manifest_salt")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  organizer              User                  @relation("event_organizer", fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes            TicketType[]
  orders                 Order[]
  tickets                Ticket[]
  resaleListings         ResaleListing[]
  staffMemberships       StaffMembership[]
  scanSessions           ScanSession[]
  scanAttempts           ScanAttempt[]
  payoutRecords          PayoutRecord[]
  webhookEvents          WebhookEvent[]
  ticketOfferRequests    TicketOfferRequest[]
  shareAnalytics         EventShareAnalytics[]
  paymentTransactions    PaymentTransaction[]
  organizerEarnings      OrganizerEarning[]

  @@index([organizerId, status])
  @@index([startsAt])
  @@map("events")
}

model EventShareAnalytics {
  id            String           @id @default(cuid())
  eventId       String           @map("event_id")
  eventSlug     String           @map("event_slug")
  eventName     String           @map("event_name")
  eventAction   EventShareAction @map("event_action")
  sourceSurface String           @map("source_surface")
  userId        String?          @map("user_id")
  sessionId     String?          @map("session_id")
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([eventAction, createdAt])
  @@index([sourceSurface, createdAt])
  @@map("event_share_analytics")
}

model TicketType {
  id                     String               @id @default(cuid())
  eventId                String               @map("event_id")
  name                   String
  description            String?
  price                  Decimal              @db.Decimal(10, 2)
  pricingMode            TicketPricingMode    @default(FIXED) @map("pricing_mode")
  minOfferPrice          Decimal?             @map("min_offer_price") @db.Decimal(10, 2)
  maxOfferPrice          Decimal?             @map("max_offer_price") @db.Decimal(10, 2)
  offerAutoExpireMinutes Int                  @default(30) @map("offer_auto_expire_minutes")
  currency               String               @default("EUR")
  quantity               Int
  maxPerOrder            Int?                 @map("max_per_order")
  saleStartsAt           DateTime?            @map("sale_starts_at")
  saleEndsAt             DateTime?            @map("sale_ends_at")
  sortOrder              Int                  @default(0) @map("sort_order")
  isActive               Boolean              @default(true) @map("is_active")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  event                  Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  tickets                Ticket[]
  offerRequests          TicketOfferRequest[]

  @@index([eventId, isActive])
  @@map("ticket_types")
}

model Order {
  id                  String               @id @default(cuid())
  userId              String               @map("user_id")
  eventId             String               @map("event_id")
  status              OrderStatus          @default(PENDING)
  currency            String               @default("EUR")
  subtotalAmount      Decimal              @map("subtotal_amount") @db.Decimal(10, 2)
  feeAmount           Decimal              @default(0) @map("fee_amount") @db.Decimal(10, 2)
  totalAmount         Decimal              @map("total_amount") @db.Decimal(10, 2)
  paymentProvider     PaymentProvider      @default(STRIPE) @map("payment_provider")
  paymentReference    String?              @unique @map("payment_reference")
  checkoutSessionId   String?              @unique @map("checkout_session_id")
  idempotencyKey      String?              @unique @map("idempotency_key")
  paidAt              DateTime?            @map("paid_at")
  cancelledAt         DateTime?            @map("cancelled_at")
  refundedAt          DateTime?            @map("refunded_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  tickets             Ticket[]
  payoutRecords       PayoutRecord[]
  paymentTransactions PaymentTransaction[]
  organizerEarnings   OrganizerEarning[]
  refunds             Refund[]

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String     @map("order_id")
  ticketTypeId String     @map("ticket_type_id")
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal    @map("total_price") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Ticket {
  id                String                   @id @default(cuid())
  eventId           String                   @map("event_id")
  ticketTypeId      String                   @map("ticket_type_id")
  orderId           String                   @map("order_id")
  currentOwnerId    String                   @map("current_owner_id")
  status            TicketStatus             @default(ISSUED)
  serialNumber      String                   @unique @map("serial_number")
  qrTokenId         String                   @unique @map("qr_token_id")
  ownershipRevision Int                      @default(1) @map("ownership_revision")
  issuedAt          DateTime?                @map("issued_at")
  reservedUntil     DateTime?                @map("reserved_until")
  usedAt            DateTime?                @map("used_at")
  cancelledAt       DateTime?                @map("cancelled_at")
  refundedAt        DateTime?                @map("refunded_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  event             Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType        TicketType               @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currentOwner      User                     @relation("ticket_current_owner", fields: [currentOwnerId], references: [id], onDelete: Restrict)
  ownershipHistory  TicketOwnershipHistory[]
  transferRequests  TransferRequest[]
  resaleListings    ResaleListing[]
  scanAttempts      ScanAttempt[]

  @@index([eventId, status])
  @@index([currentOwnerId, status])
  @@index([ticketTypeId])
  @@map("tickets")
}

model TicketOwnershipHistory {
  id         String              @id @default(cuid())
  ticketId   String              @map("ticket_id")
  fromUserId String?             @map("from_user_id")
  toUserId   String?             @map("to_user_id")
  changeType OwnershipChangeType @map("change_type")
  revision   Int
  metadata   Json?
  createdAt  DateTime            @default(now()) @map("created_at")
  ticket     Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUser   User?               @relation("ownership_from_user", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser     User?               @relation("ownership_to_user", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, revision])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("ticket_ownership_history")
}

model TransferRequest {
  id              String         @id @default(cuid())
  ticketId        String         @map("ticket_id")
  senderUserId    String         @map("sender_user_id")
  recipientUserId String?        @map("recipient_user_id")
  recipientEmail  String?        @map("recipient_email")
  status          TransferStatus @default(PENDING)
  transferToken   String         @unique @map("transfer_token")
  message         String?
  expiresAt       DateTime       @map("expires_at")
  reminderSentAt  DateTime?      @map("reminder_sent_at")
  acceptedAt      DateTime?      @map("accepted_at")
  cancelledAt     DateTime?      @map("cancelled_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser      User           @relation("transfer_sender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipientUser   User?          @relation("transfer_recipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, status])
  @@index([senderUserId, status])
  @@index([recipientUserId, status])
  @@map("transfer_requests")
}

model UserNotification {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String
  body      String
  actionUrl String?            @map("action_url")
  metadata  Json?
  readAt    DateTime?          @map("read_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([type, createdAt])
  @@map("user_notifications")
}

model PushDevice {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  expoPushToken    String           @unique @map("expo_push_token")
  platform         PushPlatform
  status           PushDeviceStatus @default(ACTIVE)
  deviceName       String?          @map("device_name")
  appVersion       String?          @map("app_version")
  lastRegisteredAt DateTime         @default(now()) @map("last_registered_at")
  lastDeliveredAt  DateTime?        @map("last_delivered_at")
  lastErrorAt      DateTime?        @map("last_error_at")
  lastErrorReason  String?          @map("last_error_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("push_devices")
}

model ResaleListing {
  id                     String               @id @default(cuid())
  ticketId               String               @map("ticket_id")
  sellerUserId           String               @map("seller_user_id")
  buyerUserId            String?              @map("buyer_user_id")
  eventId                String               @map("event_id")
  askingPrice            Decimal              @map("asking_price") @db.Decimal(10, 2)
  currency               String               @default("EUR")
  organizerRoyaltyAmount Decimal?             @map("organizer_royalty_amount") @db.Decimal(10, 2)
  sellerNetAmount        Decimal?             @map("seller_net_amount") @db.Decimal(10, 2)
  status                 ResaleStatus         @default(DRAFT)
  paymentProvider        PaymentProvider      @default(STRIPE) @map("payment_provider")
  saleReference          String?              @unique @map("sale_reference")
  listedAt               DateTime?            @map("listed_at")
  soldAt                 DateTime?            @map("sold_at")
  expiresAt              DateTime?            @map("expires_at")
  cancelledAt            DateTime?            @map("cancelled_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  ticket                 Ticket               @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event                  Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  sellerUser             User                 @relation("resale_seller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  buyerUser              User?                @relation("resale_buyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  payoutRecords          PayoutRecord[]
  paymentTransactions    PaymentTransaction[]
  organizerEarnings      OrganizerEarning[]

  @@index([ticketId, status])
  @@index([eventId, status])
  @@index([sellerUserId, status])
  @@map("resale_listings")
}

model TicketOfferRequest {
  id                  String                   @id @default(cuid())
  eventId             String                   @map("event_id")
  ticketTypeId        String                   @map("ticket_type_id")
  attendeeUserId      String                   @map("attendee_user_id")
  offeredPrice        Decimal                  @map("offered_price") @db.Decimal(10, 2)
  currency            String                   @default("EUR")
  status              TicketOfferRequestStatus @default(PENDING)
  organizerNote       String?                  @map("organizer_note")
  reviewedByUserId    String?                  @map("reviewed_by_user_id")
  reviewedAt          DateTime?                @map("reviewed_at")
  expiresAt           DateTime                 @map("expires_at")
  checkoutUnlockToken String?                  @map("checkout_unlock_token")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  event               Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType          TicketType               @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendeeUser        User                     @relation("offer_attendee", fields: [attendeeUserId], references: [id], onDelete: Restrict)
  reviewedByUser      User?                    @relation("offer_reviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, status, createdAt])
  @@index([ticketTypeId, status])
  @@index([attendeeUserId, status, createdAt])
  @@index([expiresAt, status])
  @@map("ticket_offer_requests")
}

model StaffMembership {
  id           String        @id @default(cuid())
  eventId      String        @map("event_id")
  userId       String        @map("user_id")
  role         StaffRole
  invitedAt    DateTime?     @map("invited_at")
  acceptedAt   DateTime?     @map("accepted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanSessions ScanSession[]
  scanAttempts ScanAttempt[]

  @@unique([eventId, userId])
  @@index([userId, role])
  @@map("staff_memberships")
}

model ScanSession {
  id                String           @id @default(cuid())
  eventId           String           @map("event_id")
  staffMembershipId String?          @map("staff_membership_id")
  startedByUserId   String?          @map("started_by_user_id")
  deviceLabel       String?          @map("device_label")
  deviceFingerprint String?          @map("device_fingerprint")
  mode              ScanMode         @default(ONLINE)
  manifestVersion   Int?             @map("manifest_version")
  lastSyncedAt      DateTime?        @map("last_synced_at")
  startedAt         DateTime         @default(now()) @map("started_at")
  endedAt           DateTime?        @map("ended_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMembership   StaffMembership? @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)
  startedByUser     User?            @relation("scan_session_started_by", fields: [startedByUserId], references: [id], onDelete: SetNull)
  scanAttempts      ScanAttempt[]

  @@index([eventId, startedAt])
  @@index([deviceFingerprint])
  @@map("scan_sessions")
}

model ScanAttempt {
  id                String           @id @default(cuid())
  eventId           String           @map("event_id")
  ticketId          String?          @map("ticket_id")
  scanSessionId     String?          @map("scan_session_id")
  staffMembershipId String?          @map("staff_membership_id")
  scannedByUserId   String?          @map("scanned_by_user_id")
  scannedQrTokenId  String?          @map("scanned_qr_token_id")
  scannedRevision   Int?             @map("scanned_revision")
  outcome           ScanOutcome
  reasonCode        String?          @map("reason_code")
  scannedAt         DateTime         @default(now()) @map("scanned_at")
  deviceRecordedAt  DateTime?        @map("device_recorded_at")
  offlineQueuedAt   DateTime?        @map("offline_queued_at")
  syncedAt          DateTime?        @map("synced_at")
  metadata          Json?
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket            Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  scanSession       ScanSession?     @relation(fields: [scanSessionId], references: [id], onDelete: SetNull)
  staffMembership   StaffMembership? @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)
  scannedByUser     User?            @relation("scan_attempt_staff", fields: [scannedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([scanSessionId, scannedAt])
  @@index([outcome, scannedAt])
  @@map("scan_attempts")
}

model PayoutRecord {
  id                   String          @id @default(cuid())
  eventId              String          @map("event_id")
  orderId              String?         @map("order_id")
  resaleListingId      String?         @map("resale_listing_id")
  paymentProvider      PaymentProvider @default(STRIPE) @map("payment_provider")
  payoutReference      String?         @unique @map("payout_reference")
  grossAmount          Decimal         @map("gross_amount") @db.Decimal(10, 2)
  feeAmount            Decimal         @default(0) @map("fee_amount") @db.Decimal(10, 2)
  netAmount            Decimal         @map("net_amount") @db.Decimal(10, 2)
  currency             String          @default("EUR")
  status               PayoutStatus    @default(PENDING)
  settlementState      SettlementState @default(PENDING) @map("settlement_state")
  scheduledAt          DateTime?       @map("scheduled_at")
  expectedSettlementAt DateTime?       @map("expected_settlement_at")
  paidAt               DateTime?       @map("paid_at")
  failedAt             DateTime?       @map("failed_at")
  settledAt            DateTime?       @map("settled_at")
  settlementReference  String?         @map("settlement_reference")
  failureReason        String?         @map("failure_reason")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  event                Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resaleListing        ResaleListing?  @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([orderId])
  @@index([resaleListingId])
  @@map("payout_records")
}

model WebhookEvent {
  id               String          @id @default(cuid())
  eventId          String?         @map("event_id")
  provider         PaymentProvider @default(STRIPE)
  providerEventId  String          @unique @map("provider_event_id")
  eventType        String          @map("event_type")
  payload          Json
  deliveryAttempts Int             @default(0) @map("delivery_attempts")
  lastAttemptAt    DateTime?       @map("last_attempt_at")
  processedAt      DateTime?       @map("processed_at")
  processingError  String?         @map("processing_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  event            Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([provider, eventType])
  @@map("webhook_events")
}

model OrganizerPaymentProfile {
  id                        String    @id @default(cuid())
  organizerId               String    @unique @map("organizer_id")
  defaultSettlementCurrency String?   @map("default_settlement_currency")
  isReadyForPaidEvents      Boolean   @default(false) @map("is_ready_for_paid_events")
  readinessCheckedAt        DateTime? @map("readiness_checked_at")
  firstReadyAt              DateTime? @map("first_ready_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  organizer                 User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([isReadyForPaidEvents, updatedAt])
  @@map("organizer_payment_profiles")
}

model PaymentAccount {
  id                        String                         @id @default(cuid())
  organizerId               String                         @map("organizer_id")
  provider                  PaymentProvider
  status                    PaymentAccountStatus           @default(NOT_STARTED)
  accountType               ConnectedAccountType?          @map("account_type")
  verificationStatus        PaymentVerificationStatus      @default(UNVERIFIED) @map("verification_status")
  onboardingStatus          PaymentAccountOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  externalAccountId         String                         @map("external_account_id")
  externalAccountCode       String?                        @map("external_account_code")
  payoutsEnabled            Boolean                        @default(false) @map("payouts_enabled")
  chargesEnabled            Boolean                        @default(false) @map("charges_enabled")
  detailsSubmitted          Boolean                        @default(false) @map("details_submitted")
  country                   String?
  defaultCurrency           String?                        @map("default_currency")
  currentlyDueRequirements  String[]                       @default([]) @map("currently_due_requirements")
  eventuallyDueRequirements String[]                       @default([]) @map("eventually_due_requirements")
  pastDueRequirements       String[]                       @default([]) @map("past_due_requirements")
  onboardingCompletedAt     DateTime?                      @map("onboarding_completed_at")
  requirementsDueBy         DateTime?                      @map("requirements_due_by")
  requirementsSummary       String?                        @map("requirements_summary")
  disabledReason            String?                        @map("disabled_reason")
  lastSyncedAt              DateTime?                      @map("last_synced_at")
  metadata                  Json?
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")
  organizer                 User                           @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalAccountId])
  @@unique([organizerId, provider])
  @@index([status, updatedAt])
  @@map("payment_accounts")
}

model PaymentTransaction {
  id                       String                   @id @default(cuid())
  organizerId              String                   @map("organizer_id")
  eventId                  String                   @map("event_id")
  orderId                  String?                  @map("order_id")
  resaleListingId          String?                  @map("resale_listing_id")
  provider                 PaymentProvider
  type                     PaymentTransactionType   @default(PRIMARY_TICKET_PURCHASE)
  status                   PaymentTransactionStatus @default(PENDING)
  providerReference        String                   @map("provider_reference")
  providerCheckoutId       String?                  @map("provider_checkout_id")
  providerPaymentIntentId  String?                  @map("provider_payment_intent_id")
  providerChargeId         String?                  @map("provider_charge_id")
  providerTransferId       String?                  @map("provider_transfer_id")
  providerApplicationFeeId String?                  @map("provider_application_fee_id")
  connectedAccountId       String?                  @map("connected_account_id")
  amount                   Decimal                  @db.Decimal(10, 2)
  currency                 String
  grossAmount              Decimal                  @map("gross_amount") @db.Decimal(10, 2)
  platformFeeAmount        Decimal                  @default(0) @map("platform_fee_amount") @db.Decimal(10, 2)
  organizerNetAmount       Decimal                  @default(0) @map("organizer_net_amount") @db.Decimal(10, 2)
  settlementState          SettlementState          @default(PENDING) @map("settlement_state")
  idempotencyKey           String?                  @map("idempotency_key")
  capturedAt               DateTime?                @map("captured_at")
  settledAt                DateTime?                @map("settled_at")
  canceledAt               DateTime?                @map("canceled_at")
  failedAt                 DateTime?                @map("failed_at")
  failureReason            String?                  @map("failure_reason")
  metadata                 Json?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  organizer                User                     @relation("payment_transaction_organizer", fields: [organizerId], references: [id], onDelete: Restrict)
  event                    Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order                    Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resaleListing            ResaleListing?           @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  platformFees             PlatformFee[]
  organizerEarnings        OrganizerEarning[]
  refunds                  Refund[]
  disputes                 Dispute[]

  @@unique([provider, providerReference])
  @@unique([provider, providerPaymentIntentId])
  @@unique([provider, providerChargeId])
  @@index([orderId])
  @@index([organizerId, createdAt])
  @@index([resaleListingId])
  @@index([connectedAccountId, createdAt])
  @@index([eventId, status, createdAt])
  @@map("payment_transactions")
}

model PlatformFee {
  id                   String               @id @default(cuid())
  paymentTransactionId String               @map("payment_transaction_id")
  amount               Decimal              @db.Decimal(10, 2)
  currency             String
  responsibility       String               @default("BUYER")
  model                String               @default("BLENDED")
  percentRate          Decimal?             @map("percent_rate") @db.Decimal(10, 6)
  fixedAmount          Decimal?             @map("fixed_amount") @db.Decimal(10, 2)
  fixedFeeApplication  FixedFeeApplication? @map("fixed_fee_application")
  pricingRuleId        String?              @map("pricing_rule_id")
  pricingRuleSnapshot  Json?                @map("pricing_rule_snapshot")
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  paymentTransaction   PaymentTransaction   @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
  @@map("platform_fees")
}

model OrganizerEarning {
  id                   String             @id @default(cuid())
  organizerId          String             @map("organizer_id")
  eventId              String             @map("event_id")
  orderId              String?            @map("order_id")
  resaleListingId      String?            @map("resale_listing_id")
  paymentTransactionId String             @map("payment_transaction_id")
  grossAmount          Decimal            @map("gross_amount") @db.Decimal(10, 2)
  platformFeeAmount    Decimal            @default(0) @map("platform_fee_amount") @db.Decimal(10, 2)
  netAmount            Decimal            @map("net_amount") @db.Decimal(10, 2)
  currency             String
  settlementState      SettlementState    @default(PENDING) @map("settlement_state")
  settledAt            DateTime?          @map("settled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  organizer            User               @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order                Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resaleListing        ResaleListing?     @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([organizerId, settlementState, createdAt])
  @@index([eventId, createdAt])
  @@index([orderId])
  @@index([resaleListingId])
  @@index([paymentTransactionId])
  @@map("organizer_earnings")
}

model Refund {
  id                   String              @id @default(cuid())
  orderId              String?             @map("order_id")
  paymentTransactionId String?             @map("payment_transaction_id")
  provider             PaymentProvider
  status               RefundStatus        @default(REQUESTED)
  providerRefundId     String?             @map("provider_refund_id")
  providerReversalId   String?             @map("provider_reversal_id")
  amount               Decimal             @db.Decimal(10, 2)
  currency             String
  reverseTransfer      Boolean             @default(false) @map("reverse_transfer")
  refundApplicationFee Boolean             @default(false) @map("refund_application_fee")
  reason               String?
  requestedByUserId    String?             @map("requested_by_user_id")
  requestedAt          DateTime            @default(now()) @map("requested_at")
  processedAt          DateTime?           @map("processed_at")
  failedAt             DateTime?           @map("failed_at")
  failureReason        String?             @map("failure_reason")
  metadata             Json?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRefundId])
  @@index([orderId, createdAt])
  @@index([paymentTransactionId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

model Dispute {
  id                   String             @id @default(cuid())
  paymentTransactionId String             @map("payment_transaction_id")
  provider             PaymentProvider
  providerDisputeId    String             @map("provider_dispute_id")
  providerChargeId     String?            @map("provider_charge_id")
  amount               Decimal            @db.Decimal(10, 2)
  currency             String
  reason               String?
  status               String
  evidenceDueBy        DateTime?          @map("evidence_due_by")
  needsResponse        Boolean            @default(false) @map("needs_response")
  wonAt                DateTime?          @map("won_at")
  lostAt               DateTime?          @map("lost_at")
  closedAt             DateTime?          @map("closed_at")
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerDisputeId])
  @@index([paymentTransactionId])
  @@index([providerChargeId])
  @@index([status, createdAt])
  @@map("disputes")
}
